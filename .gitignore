# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets (commit .env_mlflow.example, not the real file)
# Note: .env.* does NOT match .env_mlflow (underscore) — list it explicitly.
.env
.env.*
!.env.example
cronologia/.env.example
.env_mlflow
!.env_mlflow.example
*.key
config_local.yaml

# Model weights / large artifacts (Phase 1+ LLM inference)
*.gguf
*.bin
*.safetensors
models/
checkpoints/

# Derived / generated training data (regenerate via scripts/build_fixed_dataset.py)
mlops/data/
mlops/runs/

# Corpora (Phase 2+ ingestion) - keep out of git by default
data/raw/
data/corpus/

# MLflow (backend is PostgreSQL; local store is a build artifact)
mlruns/

# Docker runtime volumes
docker/volumes/
volumes/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# CronologIA
cronologia/volumes/
cronologia/.env
cronologia/*.db
