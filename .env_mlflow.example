# ── PoesIA MLflow environment — TEMPLATE ───────────────────────────────
# Copy to .env_mlflow and adjust values for your setup.
#   cp .env_mlflow.example .env_mlflow
#
# Local Docker stack (docker-compose.yml):
#   POSTGRES_USER/PASSWORD/DB default to mlflow/mlflow/mlflow
#   MLFLOW_TRACKING_URI points at the Docker PostgreSQL on localhost:5432
# ───────────────────────────────────────────────────────────────────────

# MLflow tracking backend — PostgreSQL for concurrent access and team use
export MLFLOW_TRACKING_URI="postgresql://mlflow:mlflow@localhost:5432/mlflow"
export DATABASE_URL="postgresql://mlflow:mlflow@localhost:5432/mlflow"

# Optional: pick a model from the MLflow registry via the CLI
# export MLFLOW_MODEL_URI="models:/poesia-lora-soneto-qwen3b/1"

# Optional: override the default LoRA adapter
# export LORA_ADAPTER_PATH="/home/angel/dev/poesia/models/poetry-lora-v2-fixed/final_adapter"

# Optional: HF token for higher rate limits
# export HF_TOKEN="hf_..."
